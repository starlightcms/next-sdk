{
  "name": "@starlightcms/next-sdk",
  "version": "3.1.0-beta.1",
  "description": "The Starlight SDK for Next",
  "main": "dist/cjs/index.js",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "rimraf dist && npm run build:cjs && npm run build:esm && npm run build:css",
    "build:esm": "tsc --module esnext --outDir dist/esm",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "build:css": "copyfiles -f \"./node_modules/@starlightcms/react-sdk/dist/styles.*\" dist",
    "dev": "tsc --watch --module esnext --outDir dist/esm",
    "dev:cjs": "tsc --watch --module commonjs --outDir dist/cjs",
    "prepare": "husky install",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starlightcms/next-sdk.git"
  },
  "keywords": [
    "starlight",
    "sdk"
  ],
  "author": "Lucas Varela <hi@lucasvarela.dev>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/starlightcms/next-sdk/issues"
  },
  "homepage": "https://github.com/starlightcms/next-sdk#readme",
  "devDependencies": {
    "@types/node": "^24.10.3",
    "@types/react": "^18.3.27",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^7.0.2",
    "lint-staged": "^11.1.2",
    "prettier": "2.4.1",
    "rimraf": "^3.0.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@starlightcms/react-sdk": "^3.1.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  }
}
